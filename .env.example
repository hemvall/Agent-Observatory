# Copy to .dev.vars for local development. Restart pnpm dev after editing.
# Server secrets only. Never use NEXT_PUBLIC_ for a key.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternative: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Without AI_PROVIDER: Groq is selected when GROQ_API_KEY is set, otherwise OpenAI.
# Explicit selection never silently falls back to another provider.
